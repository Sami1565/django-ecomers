{
    "builds": [
        {
            "src": "ecommerce_project/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "10mb",
                "runtime": "python3.12"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/media/(.*)",
            "dest": "/media/$1"
        },
        {
            "src": "/(.*)",
            "dest": "ecommerce_project/wsgi.py"
        }
    ],
    "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput && python build_migrations.py",
    "env": {
        "DJANGO_SETTINGS_MODULE": "ecommerce_project.settings",
        "VERCEL": "true",
        "PYTHONUNBUFFERED": "1"
    }
}